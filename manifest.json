{
  "manifest_version": 3,
  "name": "Index",
  "version": "1.0.0",
  "description": "Pinned sites, recent sites and local dev servers on every new tab.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "history",
    "storage",
    "favicon",
    "search"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
